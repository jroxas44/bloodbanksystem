generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  hashedPassword String
  role           String   @default("CLERK")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Donor {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       String
  bloodType    String
  rhFactor     String
  email        String?
  phone        String
  address      String
  city         String
  state        String
  zipCode      String
  status       String     @default("ACTIVE")
  lastDonation DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  donations    Donation[]
}

model Donation {
  id              String   @id @default(cuid())
  donorId         String
  donor           Donor    @relation(fields: [donorId], references: [id])
  donationDate    DateTime @default(now())
  volumeMl        Int      @default(450)
  bloodType       String
  rhFactor        String
  status          String   @default("COLLECTED")
  hemoglobinLevel Float?
  notes           String?  @db.Text
  collectedBy     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([donorId])
}

model BloodInventory {
  id             String   @id @default(cuid())
  bloodType      String
  rhFactor       String
  unitsAvailable Int      @default(0)
  minimumStock   Int      @default(5)
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([bloodType, rhFactor])
}

model BloodRequest {
  id             String   @id @default(cuid())
  patientName    String
  patientAge     Int
  bloodType      String
  rhFactor       String
  unitsRequested Int
  urgency        String   @default("NORMAL")
  hospitalName   String
  doctorName     String
  status         String   @default("PENDING")
  notes          String?  @db.Text
  requestedBy    String
  processedBy    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
